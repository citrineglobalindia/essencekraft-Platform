# Supabase (Project Settings → API). Leave blank to run storefront in demo mode with seed data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://www.essencekraft.in
# Optional
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000
# Server-only secrets (Vercel → Settings → Environment Variables). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
